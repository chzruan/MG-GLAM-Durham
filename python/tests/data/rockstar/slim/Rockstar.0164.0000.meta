product = Rockstar
format = raw little-endian records, 168 bytes per distinct halo: 40 columns of Rockstar's struct halo (MPI-Rockstar halo.h with OUTPUT_RVMAX, OUTPUT_NFW_CHI2, OUTPUT_INERTIA_TENSOR) and of the adapter's strict-SO columns, at the offsets below (GLAM_FULL_RECORD = 0; 1 writes all 352 bytes); no header
record_bytes = 168
status = ok
reason = -
a = 1.00000000
a_x = 1.00000000   (epoch of the positions; same as a)
z = 0.00000000
a_v = 0.99730119   (epoch of the velocities, a - da/2: GLAM's momenta lag the positions by half a step)
da = 0.00539762
velocity_scale = 1/a_v   (velocities are peculiar km/s at a_v: code velocity * 100 Box/N_grid / a_v)
step = 164
realization = 0
Box = 512.0000
N_grid = 2048
N_row = 1024
N_p = 1073741824
Omega_m = 0.308900
Omega_L = 0.691100
hubble = 0.677400
particle_mass = 1.07157308e+10   (Msun/h, Rockstar's: CRITICAL_DENSITY Omega_m Box^3 / N_p)
MG_flag = 0
MG_model = 1
fR0 = none
finder = in-line Rockstar of MG-GLAM (rockstar_inline/), MPI-Rockstar 0ae386f11865; Intel(R) oneAPI DPC++/C++ Compiler 2024.2.0 (2024.2.0.20240602): icx -O2 -g -march=core-avx2 -mcmodel=medium -fp-model=precise -fno-math-errno -fexceptions -fiopenmp -DOUTPUT_RVMAX -DOUTPUT_NFW_CHI2 -DOUTPUT_INERTIA_TENSOR -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -D_DEFAULT_SOURCE -D_POSIX_SOURCE -D_POSIX_C_SOURCE=200809L -D_SVID_SOURCE; -std=c99 (Rockstar), -std=gnu11 (adapter), -ffp-contract=off (FoF)
config_file = Rockstar.config
config_fnv1a64 = db43c65db3a209a5
header = ic2pm: 2LPTic ingest, v at a-da/2, ID?
rows = 3
halos_selected = 2525614 (after Rockstar's output filter; the 739015 subhaloes among them are not written)
min_mgrav_particles = 20 (GLAM_MIN_MGRAV_PARTICLES: a distinct halo is written when mgrav >= (N - 1/2) particle masses; 0 = every distinct halo)
rows_below_min_mgrav = 559138 (distinct haloes not written)
full_record = 0 (GLAM_FULL_RECORD)
positions = x [Mpc/h comoving] = (x_grid - 1) * Box/N_grid, wrapped into [0, Box)
fof_r_link = 0.140000001
fof = exact periodic friends-of-friends of the adapter (rs_fof.c), d^2 < r^2 in float; Rockstar's own FoF additionally merges groups within 2r of particles with > 16 neighbours
FORCE_RES_configured = 0.1 (config.FORCE_RES is the value used, capped at FORCE_RES_PHYS_MAX / a)
bound_props = with BOUND_PROPS = 1 Rockstar computes every property except m from the bound particles (r, the alt_m_*, vmax, vrms, J, spins, shapes, ...)
strict_so = 1
selection = distinct haloes only: no parent in Rockstar's find_parents with the kernel radius r (ties in vmax taken in row order), with mgrav of at least min_mgrav_particles particles. Rockstar's kernel still finds substructure, and a halo's masses and properties include the particles of its substructure (num_child_particles)
member_order = particle id (each FoF group is handed to find_subs sorted by particle id)
fof_groups = 4276124
fof_members = 550925602
fof_fraction = 0.513089
fof_largest = 447158
halos_internal = 8136819
threads = 16
time_fof_s = 99.50
time_gather_s = 9.29
time_kernel_s = 125.48
time_strict_s = 5.27
time_parents_s = 3.29
vmrss_entry_gib = 24.010
vmrss_max_sampled_gib = 55.612
vmhwm_entry_gib = 24.027
vmhwm_exit_gib = 55.609 (above the entry value only if this call set the process's peak)
need_fof_gib = 35.650
need_kernel_gib = 26.587
memory_ceiling_gib = 77.6
memory_ceiling_configured_gib = 900.0
memory_limit_gib = 80.0 (cgroup /sys/fs/cgroup/system.slice/slurmstepd.scope/job_12342407/step_batch/user/memory.max)
