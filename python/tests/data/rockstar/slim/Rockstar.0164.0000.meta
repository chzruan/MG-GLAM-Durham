columns = id num_p x y z vx vy vz m mgrav r vmax rvmax vrms rs Jx Jy Jz spin bullock_spin alt_m_1 alt_m_2 alt_m_3 alt_m_4 Xoff Voff kin_to_pot b_to_a c_to_a Ax Ay Az halfmass_radius m_strict r_strict alt_m_strict_1 alt_m_strict_2 alt_m_strict_3 alt_m_strict_4 strict_crossed
dtypes = i8 i8 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 i4
offsets = 0 8 16 20 24 28 32 36 40 44 48 52 56 60 64 68 72 76 80 84 88 92 96 100 104 108 112 116 120 124 128 132 136 140 144 148 152 156 160 164
units = - - Mpc/h Mpc/h Mpc/h km/s km/s km/s Msun/h Msun/h kpc/h km/s kpc/h km/s kpc/h Msun/h*Mpc/h*km/s Msun/h*Mpc/h*km/s Msun/h*Mpc/h*km/s - - Msun/h Msun/h Msun/h Msun/h kpc/h km/s - - - kpc/h kpc/h kpc/h kpc/h Msun/h kpc/h Msun/h Msun/h Msun/h Msun/h -
column_01 = id: row number in this catalogue (distinct haloes only)
column_02 = num_p: particles assigned to the halo itself, without its substructure (out_*.list Np)
column_03 = x: Mpc/h comoving, in [0, Box)
column_04 = y: Mpc/h comoving, in [0, Box)
column_05 = z: Mpc/h comoving, in [0, Box)
column_06 = vx: km/s physical peculiar (Rockstar halo velocity, out_*.list VX)
column_07 = vy: km/s physical peculiar
column_08 = vz: km/s physical peculiar
column_09 = m: Msun/h, MASS_DEFINITION, all assigned particles (out_*.list Mvir_all)
column_10 = mgrav: Msun/h, MASS_DEFINITION, bound particles (out_*.list Mvir when BOUND_PROPS = 1)
column_11 = r: kpc/h comoving, radius of MASS_DEFINITION from the bound mass mgrav (BOUND_PROPS = 1)
column_12 = vmax: km/s physical
column_13 = rvmax: kpc/h comoving, radius of vmax
column_14 = vrms: km/s physical
column_15 = rs: kpc/h comoving, NFW scale radius
column_16 = Jx: (Msun/h) (Mpc/h) km/s physical
column_17 = Jy: (Msun/h) (Mpc/h) km/s physical
column_18 = Jz: (Msun/h) (Mpc/h) km/s physical
column_19 = spin: Peebles spin
column_20 = bullock_spin: Bullock spin
column_21 = alt_m_1: Msun/h, MASS_DEFINITION2, bound particles (BOUND_PROPS = 1); 0: not reached
column_22 = alt_m_2: Msun/h, MASS_DEFINITION3, as alt_m_1
column_23 = alt_m_3: Msun/h, MASS_DEFINITION4, as alt_m_1
column_24 = alt_m_4: Msun/h, MASS_DEFINITION5, as alt_m_1
column_25 = Xoff: kpc/h comoving
column_26 = Voff: km/s physical
column_27 = kin_to_pot: T/|U| (Newtonian potential)
column_28 = b_to_a: axis ratio (MASS_DEFINITION)
column_29 = c_to_a: axis ratio (MASS_DEFINITION)
column_30 = Ax: kpc/h comoving, largest shape axis
column_31 = Ay: kpc/h comoving
column_32 = Az: kpc/h comoving
column_33 = halfmass_radius: kpc/h comoving
column_34 = m_strict: Msun/h, MASS_DEFINITION, every particle inside (STRICT_SO_MASSES)
column_35 = r_strict: kpc/h comoving, radius of m_strict
column_36 = alt_m_strict_1: Msun/h, MASS_DEFINITION2, every particle inside; 0: not reached
column_37 = alt_m_strict_2: Msun/h, MASS_DEFINITION3
column_38 = alt_m_strict_3: Msun/h, MASS_DEFINITION4
column_39 = alt_m_strict_4: Msun/h, MASS_DEFINITION5
column_40 = strict_crossed: bit 0: MASS_DEFINITION threshold reached by the strict pass; bits 1-4: the others
