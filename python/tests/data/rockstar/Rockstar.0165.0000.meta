config.FILES_PER_SUBDIR_OUTPUT = 0
config.SUBDIR_DIGITS_OUTPUT = 4
config.MEMORY_SAVING_TRANSFER = 0
config.MIN_SCALE_PART = 100
config.MIN_PART_PER_BIN = 15
config.MAX_SCALE_BINS = 50
columns = id x y z vx vy vz corevel_x corevel_y corevel_z bulkvel_x bulkvel_y bulkvel_z m r child_r vmax_r mgrav vmax rvmax rs klypin_rs vrms Jx Jy Jz energy spin alt_m_1 alt_m_2 alt_m_3 alt_m_4 Xoff Voff b_to_a c_to_a Ax Ay Az b_to_a2 c_to_a2 A2x A2y A2z bullock_spin kin_to_pot m_pe_b m_pe_d halfmass_radius num_p num_child_particles p_start desc flags n_core min_pos_err min_vel_err min_bulkvel_err inertia_xx inertia_yy inertia_zz inertia_xy inertia_yz inertia_zx inertia500c_xx inertia500c_yy inertia500c_zz inertia500c_xy inertia500c_yz inertia500c_zx chi2 fof_group m_strict r_strict alt_m_strict_1 alt_m_strict_2 alt_m_strict_3 alt_m_strict_4 strict_crossed pad
dtypes = i8 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 i8 i8 i8 i8 i8 i8 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 f4 i8 f4 f4 f4 f4 f4 f4 i4 i4
offsets = 0 8 12 16 20 24 28 32 36 40 44 48 52 56 60 64 68 72 76 80 84 88 92 96 100 104 108 112 116 120 124 128 132 136 140 144 148 152 156 160 164 168 172 176 180 184 188 192 196 200 208 216 224 232 240 248 252 256 260 264 268 272 276 280 284 288 292 296 300 304 308 312 320 324 328 332 336 340 344 348
units = - Mpc/h Mpc/h Mpc/h km/s km/s km/s km/s km/s km/s km/s km/s km/s Msun/h kpc/h - - Msun/h km/s kpc/h kpc/h kpc/h km/s Msun/h*Mpc/h*km/s Msun/h*Mpc/h*km/s Msun/h*Mpc/h*km/s - - Msun/h Msun/h Msun/h Msun/h kpc/h km/s - - kpc/h kpc/h kpc/h - - kpc/h kpc/h kpc/h - - Msun/h Msun/h kpc/h - - - - - - - - - - - - - - - - - - - - - - - Msun/h kpc/h Msun/h Msun/h Msun/h Msun/h - -
column_01 = id: row number in this catalogue (distinct haloes only)
column_02 = x: Mpc/h comoving, in [0, Box)
column_03 = y: Mpc/h comoving, in [0, Box)
column_04 = z: Mpc/h comoving, in [0, Box)
column_05 = vx: km/s physical peculiar (Rockstar halo velocity, out_*.list VX)
column_06 = vy: km/s physical peculiar
column_07 = vz: km/s physical peculiar
column_08 = corevel_x: km/s physical peculiar (core velocity)
column_09 = corevel_y: km/s
column_10 = corevel_z: km/s
column_11 = bulkvel_x: km/s physical peculiar (bulk velocity)
column_12 = bulkvel_y: km/s
column_13 = bulkvel_z: km/s
column_14 = m: Msun/h, MASS_DEFINITION, all assigned particles (out_*.list Mvir_all)
column_15 = r: kpc/h comoving, radius of MASS_DEFINITION from the bound mass mgrav (BOUND_PROPS = 1)
column_16 = child_r: Rockstar internal
column_17 = vmax_r: Rockstar internal
column_18 = mgrav: Msun/h, MASS_DEFINITION, bound particles (out_*.list Mvir when BOUND_PROPS = 1)
column_19 = vmax: km/s physical
column_20 = rvmax: kpc/h comoving, radius of vmax
column_21 = rs: kpc/h comoving, NFW scale radius
column_22 = klypin_rs: kpc/h comoving, scale radius from vmax and mass
column_23 = vrms: km/s physical
column_24 = Jx: (Msun/h) (Mpc/h) km/s physical
column_25 = Jy: (Msun/h) (Mpc/h) km/s physical
column_26 = Jz: (Msun/h) (Mpc/h) km/s physical
column_27 = energy: Rockstar internal (total energy used for the spin)
column_28 = spin: Peebles spin
column_29 = alt_m_1: Msun/h, MASS_DEFINITION2, bound particles (BOUND_PROPS = 1); 0: not reached
column_30 = alt_m_2: Msun/h, MASS_DEFINITION3, as alt_m_1
column_31 = alt_m_3: Msun/h, MASS_DEFINITION4, as alt_m_1
column_32 = alt_m_4: Msun/h, MASS_DEFINITION5, as alt_m_1
column_33 = Xoff: kpc/h comoving
column_34 = Voff: km/s physical
column_35 = b_to_a: axis ratio (MASS_DEFINITION)
column_36 = c_to_a: axis ratio (MASS_DEFINITION)
column_37 = Ax: kpc/h comoving, largest shape axis
column_38 = Ay: kpc/h comoving
column_39 = Az: kpc/h comoving
column_40 = b_to_a2: axis ratio (MASS_DEFINITION4; 0 when alt_m_3 = 0)
column_41 = c_to_a2: axis ratio (MASS_DEFINITION4)
column_42 = A2x: kpc/h comoving, largest shape axis (MASS_DEFINITION4)
column_43 = A2y: kpc/h comoving
column_44 = A2z: kpc/h comoving
column_45 = bullock_spin: Bullock spin
column_46 = kin_to_pot: T/|U| (Newtonian potential)
column_47 = m_pe_b: Msun/h, pseudo-evolution mass (Behroozi)
column_48 = m_pe_d: Msun/h, pseudo-evolution mass (Diemer)
column_49 = halfmass_radius: kpc/h comoving
column_50 = num_p: particles assigned to the halo itself, without its substructure (out_*.list Np)
column_51 = num_child_particles: particles of the halo and of the substructure Rockstar found in it (not written); the masses and properties use these
column_52 = p_start: -1 (no member list is written)
column_53 = desc: -1 (no merger tree)
column_54 = flags: Rockstar internal
column_55 = n_core: Rockstar internal
column_56 = min_pos_err: Rockstar internal
column_57 = min_vel_err: Rockstar internal
column_58 = min_bulkvel_err: Rockstar internal
column_59 = inertia_xx: inertia tensor (MASS_DEFINITION), as MPI-Rockstar OUTPUT_INERTIA_TENSOR
column_60 = inertia_yy: -
column_61 = inertia_zz: -
column_62 = inertia_xy: -
column_63 = inertia_yz: -
column_64 = inertia_zx: -
column_65 = inertia500c_xx: inertia tensor (MASS_DEFINITION4, 500c by default)
column_66 = inertia500c_yy: -
column_67 = inertia500c_zz: -
column_68 = inertia500c_xy: -
column_69 = inertia500c_yz: -
column_70 = inertia500c_zx: -
column_71 = chi2: NFW fit chi^2 (OUTPUT_NFW_CHI2)
column_72 = fof_group: canonical FoF group index of the halo
column_73 = m_strict: Msun/h, MASS_DEFINITION, every particle inside (STRICT_SO_MASSES)
column_74 = r_strict: kpc/h comoving, radius of m_strict
column_75 = alt_m_strict_1: Msun/h, MASS_DEFINITION2, every particle inside; 0: not reached
column_76 = alt_m_strict_2: Msun/h, MASS_DEFINITION3
column_77 = alt_m_strict_3: Msun/h, MASS_DEFINITION4
column_78 = alt_m_strict_4: Msun/h, MASS_DEFINITION5
column_79 = strict_crossed: bit 0: MASS_DEFINITION threshold reached by the strict pass; bits 1-4: the others
column_80 = pad: 0
