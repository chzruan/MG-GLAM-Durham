product = Rockstar
format = raw little-endian records, 352 bytes per distinct halo: Rockstar's struct halo (312 bytes, MPI-Rockstar halo.h with OUTPUT_RVMAX, OUTPUT_NFW_CHI2, OUTPUT_INERTIA_TENSOR) followed by the adapter's columns; no header
record_bytes = 352
status = ok
reason = -
a = 1.00000000
a_x = 1.00000000   (epoch of the positions; same as a)
z = 0.00000000
a_v = 0.99730119   (epoch of the velocities, a - da/2: GLAM's momenta lag the positions by half a step)
da = 0.00539762
velocity_scale = 1/a_v   (velocities are peculiar km/s at a_v: code velocity * 100 Box/N_grid / a_v)
step = 165
realization = 0
Box = 128.0000
N_grid = 512
N_row = 256
N_p = 16777216
Omega_m = 0.308900
Omega_L = 0.691100
hubble = 0.677400
particle_mass = 1.07157308e+10   (Msun/h, Rockstar's: CRITICAL_DENSITY Omega_m Box^3 / N_p)
MG_flag = 0
MG_model = 1
finder = in-line Rockstar of MG-GLAM (rockstar_inline/), MPI-Rockstar 0ae386f11865; Intel(R) oneAPI DPC++/C++ Compiler 2024.2.0 (2024.2.0.20240602): icx -O2 -g -march=core-avx2 -mcmodel=medium -fp-model=precise -fno-math-errno -fexceptions -fiopenmp -DOUTPUT_RVMAX -DOUTPUT_NFW_CHI2 -DOUTPUT_INERTIA_TENSOR
config_file = Rockstar.config
config_fnv1a64 = 585a672003545b8a
header = ic2pm: 2LPTic ingest, v at a-da/2, IDx
rows = 3
halos_selected = 39462 (after Rockstar's output filter; the 11366 subhaloes among them are not written)
positions = x [Mpc/h comoving] = (x_grid - 1) * Box/N_grid, wrapped into [0, Box)
fof_r_link = 0.140000001
fof = exact periodic friends-of-friends of the adapter (rs_fof.c), d^2 < r^2 in float; Rockstar's own FoF additionally merges groups within 2r of particles with > 16 neighbours
FORCE_RES_configured = 0.1 (config.FORCE_RES is the value used, capped at FORCE_RES_PHYS_MAX / a)
bound_props = with BOUND_PROPS = 1 Rockstar computes every property except m from the bound particles (r, the alt_m_*, vmax, vrms, J, spins, shapes, ...)
strict_so = 1
selection = distinct haloes only: no parent in Rockstar's find_parents with the kernel radius r (ties in vmax taken in row order). Rockstar's kernel still finds substructure, and a halo's masses and properties include the particles of its substructure (num_child_particles)
member_order = particle id (each FoF group is handed to find_subs sorted by particle id)
fof_groups = 66570
fof_members = 8612015
fof_fraction = 0.513316
fof_largest = 226417
halos_internal = 127241
threads = 4
time_fof_s = 5.69
time_gather_s = 0.42
time_kernel_s = 7.79
time_strict_s = 0.33
time_parents_s = 0.03
vmrss_entry_gib = 0.386
vmrss_max_sampled_gib = 0.926
vmhwm_entry_gib = 0.404
vmhwm_exit_gib = 0.922 (above the entry value only if this call set the process's peak)
need_fof_gib = 0.557
need_kernel_gib = 0.490
memory_ceiling_gib = 900.0
memory_ceiling_configured_gib = 900.0
memory_limit_gib = 1993.1 (cgroup /sys/fs/cgroup/user.slice/memory.max)
config.FILE_FORMAT = GLAM_INLINE
config.PARTICLE_MASS = 1.07157308e+10
config.MASS_DEFINITION = vir
config.MASS_DEFINITION2 = 200b
config.MASS_DEFINITION3 = 200c
